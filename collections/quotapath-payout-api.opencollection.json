{
  "opencollection": "1.0.0",
  "info": {
    "name": "QuotaPath data payout API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "payout",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "payout_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.quotapath.com/v1/payout/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              },
              {
                "name": "updated_since",
                "value": "",
                "type": "query",
                "description": "Unix timestamp in seconds. Specify to only return records updated after this timestamp."
              }
            ]
          }
        },
        {
          "info": {
            "name": "payout_resolved_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.quotapath.com/v1/payout/resolved/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              },
              {
                "name": "updated_since",
                "value": "",
                "type": "query",
                "description": "Unix timestamp in seconds. Specify to only return records updated after this timestamp."
              }
            ]
          }
        },
        {
          "info": {
            "name": "payout_unresolved_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.quotapath.com/v1/payout/unresolved/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}